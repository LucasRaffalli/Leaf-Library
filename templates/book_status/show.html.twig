    <a href="{{ path('app_book_status_index') }}">← Retour</a>

    <a href="{{ path('app_book_status_edit', {'id': book_status.id}) }}">Modifier</a>

    {{ include('book_status/_delete_form.html.twig') }}
{% endblock %}
