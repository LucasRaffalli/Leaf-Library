{% extends 'base.html.twig' %}

{% block title %}Gestion des statuts{% endblock %}

{% block body %}
    <h1>Statut</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ book_status.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ book_status.name }}</td>
