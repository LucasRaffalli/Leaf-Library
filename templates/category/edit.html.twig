{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier
	{{ category.name }}
	- Leaf Library
{% endblock %}

{% block admin_content %}
	<div
		class="h-screen">
		<header class="bg-white shadow">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center py-6">
					<div class="flex items-center">
						{% include 'components/logo.html.twig' with { size: '48' } %}
						<h1 class="ml-3 text-2xl font-bold text-color-900">Modifier la catégorie</h1>
					</div>
					<div class="flex items-center space-x-4">
						<a href="{{ path('app_category_show', {'id': category.id}) }}" class="text-color-600 hover:text-color-800 font-medium">← Retour aux détails</a>
					</div>
				</div>
			</div>
		</header>

		<main
			class="max-w-2xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
			<div class="bg-white shadow rounded-lg overflow-hidden">
				<div class="px-6 py-6">
					<div class="flex items-center justify-between mb-6">
						<div class="flex items-center">
							<svg class="h-8 w-8 text-color-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
							</svg>
							<div class="ml-4">
								<h2 class="text-xl font-semibold text-color-900">Modifier "{{ category.name }}"</h2>
								<p class="text-sm text-color-600 mt-1">ID: #{{ category.id }}</p>
							</div>
						</div>
					</div>

					{{ include('category/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
				</div>

				<div class="bg-red-50 border-t border-red-200 px-6 py-4">
					<div class="flex items-center justify-between">
						<div>
							<h3 class="text-sm font-medium text-red-900">Zone de danger</h3>
							<p class="text-sm text-red-700 mt-1">La suppression est irréversible</p>
						</div>
						{{ include('category/_delete_form.html.twig') }}
					</div>
				</div>
			</div>
		</main>
	</div>
{% endblock %}
