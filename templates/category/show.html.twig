{% extends 'admin/layout.html.twig' %}

{% block title %}
	{{ category.name }}
	- Leaf Library
{% endblock %}

{% block admin_content %}
	<div
		class="h-screen">
		<!-- Header -->
		<header class="bg-white shadow">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center py-6">
					<div class="flex items-center">
						{% include 'components/logo.html.twig' with { size: '48' } %}
						<h1 class="ml-3 text-2xl font-bold text-color-900">Détails de la catégorie</h1>
					</div>
					<div class="flex items-center space-x-4">
						<a href="{{ path('app_category_index') }}" class="text-color-600 hover:text-color-800 font-medium">← Retour à la liste</a>
					</div>
				</div>
			</div>
		</header>

		<main
			class="max-w-4xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
			<!-- Category Card -->
			<div
				class="bg-white shadow rounded-lg overflow-hidden">
				<!-- Header with Icon -->
				<div class="bg-gradient-to-r from-color-600 to-color-700 px-6 py-8">
					<div class="flex items-center">
						<div class="flex-shrink-0">
							<svg class="h-16 w-16 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
							</svg>
						</div>
						<div class="ml-6">
							<h2 class="text-3xl font-bold text-white">{{ category.name }}</h2>
							<p class="text-white/80 text-sm mt-1">ID: #{{ category.id }}</p>
						</div>
					</div>
				</div>

				<!-- Details -->
				<div class="px-6 py-6">
					<dl class="grid grid-cols-1 gap-6">
						<div>
							<dt class="text-sm font-medium text-color-500 uppercase tracking-wide">Identifiant</dt>
							<dd class="mt-1 text-lg text-color-900 font-semibold">#{{ category.id }}</dd>
						</div>
						<div>
							<dt class="text-sm font-medium text-color-500 uppercase tracking-wide">Nom de la catégorie</dt>
							<dd class="mt-1 text-lg text-color-900 font-semibold">{{ category.name }}</dd>
						</div>
					</dl>
				</div>

				<!-- Actions -->
				<div class="bg-color-50 px-6 py-4 flex justify-between items-center">
					<div class="flex gap-3">
						<a href="{{ path('app_category_edit', {'id': category.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-color-600 hover:bg-color-700 transition-colors">
							✏️ Modifier
						</a>
						<a href="{{ path('app_category_index') }}" class="inline-flex items-center px-4 py-2 border border-color-300 rounded-md text-sm font-medium text-color-700 bg-white hover:bg-color-50 transition-colors">
							← Retour à la liste
						</a>
					</div>
					<div>
						{{ include('category/_delete_form.html.twig') }}
					</div>
				</div>
			</div>
		</main>
	</div>
{% endblock %}
