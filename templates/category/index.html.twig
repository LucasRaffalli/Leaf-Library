{% extends 'admin/layout.html.twig' %}

{% block title %}Catégories - Leaf Library
{% endblock %}

{% block admin_content %}
	{# Page Header #}
	<div class="mb-8">
		<h1 class="text-3xl font-black text-color-900 uppercase tracking-tight">🏷️ Gestion des Catégories</h1>
		<p class="mt-2 text-color-600">Organisez vos livres par catégories</p>
	</div>

	{# Action Bar #}
	<div class="flex justify-between items-center mb-6">
		<p class="text-color-600">
			<span class="font-semibold text-color-900">{{ categories|length }}</span>
			catégorie(s) au total
		</p>
		<a href="{{ path('app_category_new') }}" class="inline-flex items-center px-4 py-2 bg-color-600 text-white font-semibold rounded-lg hover:bg-color-700 transition-colors">
			<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
			</svg>
			Nouvelle catégorie
		</a>
	</div>

	{# Categories Grid #}
	{% if categories|length > 0 %}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{% for category in categories %}
				<div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow overflow-hidden">
					<div class="p-6">
						<div class="flex items-center justify-between mb-4">
							<div class="p-3 bg-color-100 rounded-lg">
								<svg class="w-8 h-8 text-color-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
								</svg>
							</div>
						</div>
						<h3 class="text-xl font-bold text-color-900 mb-2">{{ category.name }}</h3>
						<p class="text-sm text-color-500 mb-4">
							{{ category.books|length }}
							livre(s)
						</p>
						<div class="flex gap-2">
							<a href="{{ path('app_category_show', {'id': category.id}) }}" class="flex-1 text-center px-3 py-2 bg-color-100 text-color-700 font-medium rounded-lg hover:bg-color-200 transition-colors">
								Voir
							</a>
							<a href="{{ path('app_category_edit', {'id': category.id}) }}" class="flex-1 text-center px-3 py-2 bg-color-600 text-white font-medium rounded-lg hover:bg-color-700 transition-colors">
								Modifier
							</a>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<div class="bg-white rounded-lg shadow p-12 text-center">
			<svg class="w-16 h-16 text-color-300 mx-auto mb-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
			</svg>
			<h3 class="text-lg font-medium text-color-900 mb-2">Aucune catégorie</h3>
			<p class="text-color-500 mb-4">Commencez par créer votre première catégorie</p>
			<a href="{{ path('app_category_new') }}" class="inline-flex items-center px-4 py-2 bg-color-600 text-white font-semibold rounded-lg hover:bg-color-700 transition-colors">
				<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
				</svg>
				Créer une catégorie
			</a>
		</div>
	{% endif %}
{% endblock admin_content %}
