{% extends 'base.html.twig' %}

{% block title %}
  Leaf Library
{% endblock %}

{% block body %}
  <div class="flex flex-col items-center justify-center h-full gap-2 h-screen">
    {% include 'components/logo.html.twig' with { 'size': '128' } %}
    <h1 class="text-3xl md:text-8xl uppercase text-color-900 font-black">Leaf Library</h1>
    <p class="text-sm w-80 text-color-600 md:w-200 md:text-3xl font-medium uppercase text-center">Gestion de bibliothèque moderne et intuitive</p>
    <p class="text-sm w-80 text-color-400 md:w-200 text-center">Gérez vos emprunts, consultez le catalogue, suivez vos retours et accédez à l'ensemble des ressources de la bibliothèque en toute simplicité.</p>
    <div class="flex flex-row gap-4 mt-6">
      {% include 'components/button.html.twig' with { variant: 'outline', text: 'Explorer les livres', url: path('app_catalogue') } %}
      {% include 'components/button.html.twig' with { text: 'Se connecter', url: path('app_login') } %}
    </div>
  </div>
{% endblock %}
