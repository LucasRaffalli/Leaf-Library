{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - Leaf Library{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-6">
                <div class="flex items-center">
                    {% include 'components/logo.html.twig' with { size: '48' } %}
                    <h1 class="ml-3 text-2xl font-bold text-color-900">Modifier mon profil</h1>
                </div>
                <div class="flex items-center space-x-4">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="bg-color-600 text-white px-3 py-1 rounded hover:bg-color-700 transition-colors">Admin</a>
                    {% endif %}
                    <a href="{{ path('app_profile') }}" class="text-color-600 hover:text-color-800">Retour au profil</a>
                    <a href="{{ path('app_dashboard') }}" class="text-color-600 hover:text-color-800">Dashboard</a>
                    <a href="{{ path('app_logout') }}" class="text-color-600 hover:text-color-800">Déconnexion</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main content -->
    <main class="max-w-2xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-2xl font-bold text-color-900 mb-6">Modifier mes informations</h2>
            
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div>
                    {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-color-700 mb-1'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-color-500 focus:border-color-500'}}) }}
                    {{ form_errors(form.name, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
                </div>

                <div>
                    {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-color-700 mb-1'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-color-500 focus:border-color-500'}}) }}
                    {{ form_errors(form.email, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
                    <p class="text-sm text-gray-500 mt-1">Cette adresse email sera utilisée pour vous connecter.</p>
                </div>

                <div class="flex space-x-4">
                    <button 
                        type="submit"
                        class="flex-1 bg-color-500 text-white py-2 px-4 rounded-md hover:bg-color-600 focus:outline-none focus:ring-2 focus:ring-color-500 focus:ring-offset-2 transition-colors"
                    >
                        Enregistrer les modifications
                    </button>
                    
                    <a 
                        href="{{ path('app_profile') }}"
                        class="flex-1 text-center border border-gray-300 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-color-500 focus:ring-offset-2 transition-colors"
                    >
                        Annuler
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </main>
</div>
{% endblock %}