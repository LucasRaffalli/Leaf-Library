{% extends 'base.html.twig' %}

{% block title %}Mon profil - Leaf Library
{% endblock %}

{% block body %}
	<div
		class="min-h-screen bg-gray-50">
		<!-- Header -->
		<header class="bg-white shadow">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center py-6">
					<div class="flex items-center">
						{% include 'components/logo.html.twig' with { size: '48' } %}
						<h1 class="ml-3 text-2xl font-bold text-color-900">Mon Profil</h1>
					</div>
					<div class="flex items-center space-x-4">
						{% if is_granted('ROLE_ADMIN') %}
							<a href="{{ path('app_admin_dashboard') }}" class="bg-color-600 text-white px-3 py-1 rounded hover:bg-color-700 transition-colors">Admin</a>
						{% endif %}
						<a href="{{ path('app_dashboard') }}" class="text-color-600 hover:text-color-800">Dashboard</a>
						<span class="text-color-700">{{ user.name }}</span>
						<a href="{{ path('app_logout') }}" class="text-color-600 hover:text-color-800">Déconnexion</a>
					</div>
				</div>
			</div>
		</header>

		<!-- Main content -->
		<main
			class="max-w-4xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
			<!-- Messages flash -->
			{% for message in app.flashes('success') %}
				<div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
					{{ message }}
				</div>
			{% endfor %}

			<div class="bg-white rounded-lg shadow p-6">
				<div
					class="grid grid-cols-1 lg:grid-cols-3 gap-8">
					<!-- Photo de profil (placeholder) -->
					<div class="lg:col-span-1">
						<div class="bg-color-100 h-48 w-48 rounded-full mx-auto flex items-center justify-center">
							<svg class="h-20 w-20 text-color-400" fill="currentColor" viewbox="0 0 24 24">
								<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
							</svg>
						</div>
						<div class="mt-4 text-center">
							<a href="{{ path('app_profile_edit') }}" class="bg-color-500 text-white px-4 py-2 rounded hover:bg-color-600 transition-colors">
								Modifier le profil
							</a>
						</div>
					</div>

					<!-- Informations du profil -->
					<div class="lg:col-span-2">
						<h2 class="text-2xl font-bold text-color-900 mb-6">Informations personnelles</h2>

						<div class="space-y-4">
							<div>
								<label class="block text-sm font-medium text-color-700 mb-1">Nom complet</label>
								<p class="text-lg text-color-900">{{ user.name }}</p>
							</div>

							<div>
								<label class="block text-sm font-medium text-color-700 mb-1">Adresse email</label>
								<p class="text-lg text-color-900">{{ user.email }}</p>
							</div>

							<div>
								<label class="block text-sm font-medium text-color-700 mb-1">Statut du compte</label>
								<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
										                                {% if user.isActive %}
										                                    bg-green-100 text-green-800
										                                {% else %}
										                                    bg-red-100 text-red-800
										                                {% endif %}
										                            ">
									{% if user.isActive %}
										Compte actif
									{% else %}
										Compte inactif
									{% endif %}
								</span>
							</div>

							<div>
								<label class="block text-sm font-medium text-color-700 mb-1">Rôles</label>
								<div class="flex flex-wrap gap-2">
									{% for role in user.roles %}
										<span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-color-100 text-color-700">
											{{ role|replace({'ROLE_': ''})|lower|title }}
										</span>
									{% endfor %}
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div>
									<label class="block text-sm font-medium text-color-700 mb-1">Membre depuis</label>
									<p class="text-color-900">{{ user.createdAt|date('d/m/Y') }}</p>
								</div>
								<div>
									<label class="block text-sm font-medium text-color-700 mb-1">Dernière mise à jour</label>
									<p class="text-color-900">{{ user.updateAt|date('d/m/Y à H:i') }}</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Section emprunts récents -->
			<div class="mt-8 bg-white rounded-lg shadow p-6">
				<h2 class="text-xl font-bold text-color-900 mb-4">Mes emprunts récents</h2>
				<div class="text-color-500">
					<p>Aucun emprunt pour le moment.</p>
					<p class="mt-2">
						<a href="{{ path('app_catalogue') }}" class="text-color-600 hover:text-color-800 underline">
							Parcourir le catalogue pour emprunter des livres
						</a>
					</p>
				</div>
			</div>
		</main>
	</div>
{% endblock %}
