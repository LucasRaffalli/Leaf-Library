{# Usage: {% include 'components/button.html.twig' with { variant: 'outline', text: 'Click Me', url: '#' } %} #}
{% set variant = variant|default('fill') %}
{% set text = text|default('Button') %}
{% set url = url|default('#') %}
{% set type = type|default('button') %}

{% if type == 'submit' %}
  <button type="submit"
    class=" cursor-pointer px-4 py-2 rounded-md font-medium text-center inline-block transition-colors duration-300 {% if variant == 'fill' %}

    {% elseif variant == 'outline' %}

    {% endif %}">
    {{ text }}
  </button>
{% else %}
  <a href="{{ url }}"
    class="cursor-pointer px-4 py-2 rounded-md font-medium text-center inline-block transition-colors duration-300{% if variant == 'fill' %}

    {% elseif variant == 'outline' %}

    {% endif %}">
    {{ text }}
  </a>
{% endif %}
