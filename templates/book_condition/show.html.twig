{% extends 'base.html.twig' %}

{% block title %}Gestion des conditions de livre{% endblock %}

{% block body %}
    <h1>Conditions de livre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ book_condition.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ book_condition.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_book_condition_index') }}">← Retour</a>

    <a href="{{ path('app_book_condition_edit', {'id': book_condition.id}) }}">Modifier</a>

    {{ include('book_condition/_delete_form.html.twig') }}
{% endblock %}
