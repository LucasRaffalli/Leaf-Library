{% extends 'admin/layout.html.twig' %}

{% block title %}
  Dashboard Admin - Leaf Library
{% endblock %}

{% block admin_content %}
  <div class="mb-8">
    <h1 class="text-3xl font-black text-color-900 uppercase tracking-tight">Dashboard</h1>
    <p class="mt-2 text-color-600">Vue d'ensemble de la bibliothèque</p>
  </div>

  <div class="mb-8 bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-color-200">
      <h2 class="text-lg font-bold text-color-900">Actions rapides</h2>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="{{ path('app_book_new') }}" class="flex items-center gap-3 p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors group">
          <div class="p-2 bg-blue-100 rounded-lg group-hover:bg-blue-200 transition-colors">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-color-900">Ajouter un livre</h3>
            <p class="text-sm text-color-600">Nouveau livre au catalogue</p>
          </div>
        </a>

        <a href="{{ path('app_category_new') }}" class="flex items-center gap-3 p-4 bg-green-50 rounded-lg hover:bg-green-100 transition-colors group">
          <div class="p-2 bg-green-100 rounded-lg group-hover:bg-green-200 transition-colors">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-color-900">Nouvelle catégorie</h3>
            <p class="text-sm text-color-600">Organiser les livres</p>
          </div>
        </a>

        <a href="{{ path('app_catalogue') }}" class="flex items-center gap-3 p-4 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors group">
          <div class="p-2 bg-purple-100 rounded-lg group-hover:bg-purple-200 transition-colors">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-medium text-color-900">Voir le catalogue</h3>
            <p class="text-sm text-color-600">Vue utilisateur</p>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-color-500 uppercase tracking-wide">Total Livres</p>
          <p class="mt-2 text-3xl font-bold text-color-900">{{ stats.totalBooks }}</p>
        </div>
        <div class="p-3 bg-blue-100 rounded-lg">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
      </div>
      <div class="mt-4 text-sm">
        <span class="text-green-600 font-medium">
          {{ stats.availableBooks }}
          disponibles
        </span>
        <span class="text-color-400">•</span>
        <span class="text-red-600 font-medium">
          {{ stats.borrowedBooks }}
          empruntés
        </span>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-color-500 uppercase tracking-wide">Utilisateurs</p>
          <p class="mt-2 text-3xl font-bold text-color-900">{{ stats.totalUsers }}</p>
        </div>
        <div class="p-3 bg-green-100 rounded-lg">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-4 text-sm">
        <span class="text-green-600 font-medium">
          {{ stats.activeUsers }}
          actifs
        </span>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-color-500 uppercase tracking-wide">Catégories</p>
          <p class="mt-2 text-3xl font-bold text-color-900">{{ stats.totalCategories }}</p>
        </div>
        <div class="p-3 bg-purple-100 rounded-lg">
          <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-4">
        <a href="{{ path('app_category_index') }}" class="text-sm text-purple-600 hover:text-purple-800 font-medium">Gérer →</a>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-color-500 uppercase tracking-wide">Archivés</p>
          <p class="mt-2 text-3xl font-bold text-color-900">{{ stats.archivedBooks }}</p>
        </div>
        <div class="p-3 bg-orange-100 rounded-lg">
          <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
          </svg>
        </div>
      </div>
      <div class="mt-4 text-sm text-color-500">Livres retirés</div>
    </div>

    <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-color-500 uppercase tracking-wide">Emprunts actifs</p>
          <p class="mt-2 text-3xl font-bold text-color-900">{{ stats.activeBorrows }}</p>
        </div>
        <div class="p-3 {% if stats.overdueBorrows > 0 %}{% endif %} rounded-lg">
          <svg class="w-8 h-8 {% if stats.overdueBorrows > 0 %}{% endif %}" fill="none" stroke="currentColor" viewbox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <div class="mt-4 text-sm">
        {% if stats.overdueBorrows > 0 %}
          <span class="text-red-600 font-semibold">{{ stats.overdueBorrows }} en retard</span>
        {% else %}
          <span class="text-green-600">Tous à jour</span>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-color-200">
        <h2 class="text-lg font-bold text-color-900">Emprunts récents</h2>
      </div>
      <div class="p-6">
        {% if (recentBorrows|length) > 0 %}
          <div class="space-y-3">
            {% for borrow in recentBorrows %}
              {% set isOverdue = borrow.returnDueDate < date() and borrow.status.name != 'Rendu' %}
              <div class="flex justify-between items-start p-3 {% if isOverdue %}{% endif %} rounded-lg">
                <div class="flex-1">
                  <h3 class="font-medium text-color-900">{{ borrow.book.title }}</h3>
                  <p class="text-sm text-color-600">{{ borrow.user.name ?? borrow.user.email }}</p>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-xs text-color-500">{{ borrow.borrowDate|date('d/m/Y') }}</span>
                    <span class="text-xs {% if isOverdue %}{% endif %}">{{ borrow.returnDueDate|date('d/m/Y') }}</span>
                  </div>
                </div>
                <span class="px-2 py-1 text-xs font-semibold rounded-full
									{% if borrow.status.name == 'Rendu' %}

                  {% elseif isOverdue %}

                  {% endif %}">
                  {{ borrow.status.name }}
                </span>
              </div>
            {% endfor %}
          </div>
          <div class="mt-4">
            <a href="{{ path('app_borrow_index') }}" class="text-sm text-color-600 hover:text-color-900 font-medium">Voir tous les emprunts →</a>
          </div>
        {% else %}
          <p class="text-color-500">Aucun emprunt enregistré</p>
        {% endif %}
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-color-200">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-color-900">Emprunts en retard</h2>
          {% if (overdueBorrows|length) > 0 %}
            <span class="px-2 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full">{{ overdueBorrows|length }}</span>
          {% endif %}
        </div>
      </div>
      <div class="p-6">
        {% if (overdueBorrows|length) > 0 %}
          <div class="space-y-3">
            {% for borrow in overdueBorrows|slice(0, 5) %}
              <div class="flex justify-between items-start p-3 bg-red-50 border border-red-200 rounded-lg">
                <div class="flex-1">
                  <h3 class="font-medium text-color-900">{{ borrow.book.title }}</h3>
                  <p class="text-sm text-color-600">{{ borrow.user.name ?? borrow.user.email }}</p>
                  <div class="mt-1">
                    <span class="text-xs text-red-600 font-semibold">En retard depuis le {{ borrow.returnDueDate|date('d/m/Y') }}</span>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          {% if (overdueBorrows|length) > 5 %}
            <div class="mt-3 text-sm text-color-500 text-center">+ {{ (overdueBorrows|length) - 5 }} autre(s) en retard</div>
          {% endif %}
        {% else %}
          <div class="flex items-center gap-3 p-3 bg-green-50 rounded-lg">
            <div class="p-2 bg-green-100 rounded-lg">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <p class="text-sm text-green-700 font-medium">Aucun emprunt en retard</p>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-color-200">
        <h2 class="text-lg font-bold text-color-900">Livres récents</h2>
      </div>
      <div class="p-6">
        {% if (recentBooks|length) > 0 %}
          <div class="space-y-3">
            {% for book in recentBooks %}
              <div class="flex justify-between items-center p-3 bg-color-50 rounded-lg">
                <div>
                  <h3 class="font-medium text-color-900">{{ book.title }}</h3>
                  <p class="text-sm text-color-600">{{ book.author }}</p>
                  <p class="text-xs text-color-500">{{ book.createdAt|date('d/m/Y') }}</p>
                </div>
                <span class="px-2 py-1 text-xs font-semibold rounded-full
					{% if book.status.name == 'Disponible' %}{% endif %}">{{ book.status.name }}</span>
              </div>
            {% endfor %}
          </div>
          <div class="mt-4">
            <a href="{{ path('app_book_index') }}" class="text-sm text-color-600 hover:text-color-900 font-medium">Voir tous les livres →</a>
          </div>
        {% else %}
          <p class="text-color-500">Aucun livre ajouté récemment</p>
        {% endif %}
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-color-200">
        <h2 class="text-lg font-bold text-color-900">Nouveaux utilisateurs</h2>
      </div>
      <div class="p-6">
        {% if (recentUsers|length) > 0 %}
          <div class="space-y-3">
            {% for user in recentUsers %}
              <div class="flex justify-between items-center p-3 bg-color-50 rounded-lg">
                <div>
                  <h3 class="font-medium text-color-900">{{ user.name }}</h3>
                  <p class="text-sm text-color-600">{{ user.email }}</p>
                  <p class="text-xs text-color-500">{{ user.createdAt|date('d/m/Y') }}</p>
                </div>
                <span class="px-2 py-1 text-xs font-semibold rounded-full
				{% if user.isActive %}{% endif %}">
                  {% if user.isActive %}
                    Actif
                  {% else %}
                    Inactif
                  {% endif %}
                </span>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-color-500">Aucun nouvel utilisateur</p>
        {% endif %}
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-color-200">
        <h2 class="text-lg font-bold text-color-900">Livres par catégorie</h2>
      </div>
      <div class="p-6">
        {% if (booksByCategory|length) > 0 %}
          <div class="space-y-2">
            {% for category, count in booksByCategory %}
              <div class="flex justify-between items-center">
                <span class="text-sm font-medium text-color-700">{{ category }}</span>
                <span class="text-sm text-color-500">
                  {{ count }}
                  livre(s)
                </span>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-color-500">Aucune catégorie définie</p>
        {% endif %}
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-color-200">
        <h2 class="text-lg font-bold text-color-900">État des livres</h2>
      </div>
      <div class="p-6">
        {% if (booksByCondition|length) > 0 %}
          <div class="space-y-2">
            {% for condition, count in booksByCondition %}
              <div class="flex justify-between items-center">
                <span class="text-sm font-medium text-color-700">{{ condition }}</span>
                <span class="text-sm text-color-500">
                  {{ count }}
                  livre(s)
                </span>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-color-500">Aucune condition définie</p>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
