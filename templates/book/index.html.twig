{% extends 'admin/layout.html.twig' %}

{% block title %}Livres - Leaf Library
{% endblock %}

{% block admin_content %}
	{# Page Header #}
	<div class="mb-8">
		<h1 class="text-3xl font-black text-color-900 uppercase tracking-tight">📚 Gestion des Livres</h1>
		<p class="mt-2 text-color-600">Gérez votre collection de livres</p>
	</div>

	{# Action Bar #}
	<div class="flex justify-between items-center mb-6">
		<p class="text-color-600">
			<span class="font-semibold text-color-900">{{ books|length }}</span>
			livre(s) au total
		</p>
		<a href="{{ path('app_book_new') }}" class="inline-flex items-center px-4 py-2 bg-color-600 text-white font-semibold rounded-lg hover:bg-color-700 transition-colors">
			<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
			</svg>
			Nouveau livre
		</a>
	</div>

	{# Books Grid #}
	{% if books|length > 0 %}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{% for book in books %}
				<div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow overflow-hidden">
					<div class="p-6">
						<div class="flex items-center justify-between mb-4">
							<div class="p-3 bg-blue-100 rounded-lg">
								<svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
								</svg>
							</div>
							{% if book.isArchived %}
								<span class="px-2 py-1 text-xs font-semibold rounded-full bg-orange-100 text-orange-800">
									Archivé
								</span>
							{% endif %}
						</div>
						<h3 class="text-xl font-bold text-color-900 mb-1">{{ book.title }}</h3>
						<p class="text-sm text-color-600 mb-2">{{ book.author }}</p>
						<p class="text-sm text-color-500 mb-4">Caution:
							{{ book.depositAmount }}€</p>
						<div class="flex gap-2">
							<a href="{{ path('app_book_show', {'id': book.id}) }}" class="flex-1 text-center px-3 py-2 bg-color-100 text-color-700 font-medium rounded-lg hover:bg-color-200 transition-colors">
								Voir
							</a>
							<a href="{{ path('app_book_edit', {'id': book.id}) }}" class="flex-1 text-center px-3 py-2 bg-color-600 text-white font-medium rounded-lg hover:bg-color-700 transition-colors">
								Modifier
							</a>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	{% else %}
		<div class="bg-white rounded-lg shadow p-12 text-center">
			<svg class="w-16 h-16 text-color-300 mx-auto mb-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
			</svg>
			<h3 class="text-lg font-medium text-color-900 mb-2">Aucun livre</h3>
			<p class="text-color-500 mb-4">Commencez par ajouter votre premier livre</p>
			<a href="{{ path('app_book_new') }}" class="inline-flex items-center px-4 py-2 bg-color-600 text-white font-semibold rounded-lg hover:bg-color-700 transition-colors">
				<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
				</svg>
				Ajouter un livre
			</a>
		</div>
	{% endif %}
{% endblock admin_content %}
