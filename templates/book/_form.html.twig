{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
	<div class="flex flex-col gap-2">
		{{ form_label(form.title, 'Titre du livre', {
				'label_attr': {'class': 'text-color-700 font-medium'}
			}) }}
		{{ form_widget(form.title, {
				'attr': {'class': 'px-4 py-3 border border-color-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-color-500 focus:border-transparent', 'placeholder': 'Ex: Le Seigneur des Anneaux'}
			}) }}
		{{ form_errors(form.title) }}
	</div>

	<div class="flex flex-col gap-2">
		{{ form_label(form.author, 'Auteur', {
				'label_attr': {'class': 'text-color-700 font-medium'}
			}) }}
		{{ form_widget(form.author, {
				'attr': {'class': 'px-4 py-3 border border-color-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-color-500 focus:border-transparent', 'placeholder': 'Ex: J.R.R. Tolkien'}
			}) }}
		{{ form_errors(form.author) }}
	</div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
	<div class="flex flex-col gap-2">
		{{ form_label(form.depositAmount, 'Montant de la caution (€)', {
				'label_attr': {'class': 'text-color-700 font-medium'}
			}) }}
		{{ form_widget(form.depositAmount, {
				'attr': {'class': 'px-4 py-3 border border-color-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-color-500 focus:border-transparent', 'placeholder': '0.00'}
			}) }}
		{{ form_errors(form.depositAmount) }}
	</div>

	<div class="flex flex-col gap-2">
		{{ form_label(form.isArchived, 'Statut d\'archivage', {
				'label_attr': {'class': 'text-color-700 font-medium'}
			}) }}
			<div class="border border-color-300 rounded-lg overflow-hidden bg-white">
				<div class="p-4">
					<label class="flex items-center gap-3 cursor-pointer">
						{{ form_widget(form.isArchived, {
							'attr': {'class': 'sr-only peer'}
						}) }}
						<div class="relative w-11 h-6 bg-color-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-color-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-color-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-orange-500"></div>
						<div class="flex flex-col">
							<span class="text-sm font-medium text-color-900">Archiver ce livre</span>
							<span class="text-xs text-color-500">Le livre ne sera plus visible dans le catalogue</span>
						</div>
					</label>
				</div>
			</div>
			{{ form_errors(form.isArchived) }}
		</div>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
		<div class="flex flex-col gap-2">
			{{ form_label(form.status, 'Statut', {
				'label_attr': {'class': 'text-color-700 font-medium'}
			}) }}
			<div class="border border-color-300 rounded-lg overflow-hidden bg-white">
				<div class="p-3 max-h-64 overflow-y-auto space-y-2">
					{{ form_widget(form.status, {
						'expanded': true
					}) }}
				</div>
			</div>
			<p class="text-xs text-color-500">Disponibilité du livre</p>
			{{ form_errors(form.status) }}
		</div>

		<div class="flex flex-col gap-2">
			{{ form_label(form.condition, 'État', {
				'label_attr': {'class': 'text-color-700 font-medium'}
			}) }}
			<div class="border border-color-300 rounded-lg overflow-hidden bg-white">
				<div class="p-3 max-h-64 overflow-y-auto space-y-2">
					{{ form_widget(form.condition, {
						'expanded': true
					}) }}
				</div>
			</div>
			<p class="text-xs text-color-500">Condition physique</p>
			{{ form_errors(form.condition) }}
		</div>

		<div class="flex flex-col gap-2">
			{{ form_label(form.categories, 'Catégories', {
				'label_attr': {'class': 'text-color-700 font-medium'}
			}) }}
			<div class="border border-color-300 rounded-lg overflow-hidden bg-white">
				<div class="p-3 max-h-64 overflow-y-auto space-y-2">
					{{ form_widget(form.categories, {
						'expanded': true
					}) }}
				</div>
			</div>
			<p class="text-xs text-color-500">Multi-sélection possible</p>
			{{ form_errors(form.categories) }}
		</div>
	</div>
	<div class="flex gap-3 pt-4">
		<button type="submit" class="px-6 py-3 bg-color-600 text-white font-semibold rounded-lg hover:bg-color-700 transition-colors">
			{{ button_label|default('Enregistrer') }}
		</button>
		<a href="{{ path('app_book_index') }}" class="inline-flex items-center px-6 py-3 border border-color-300 rounded-lg text-color-700 font-semibold hover:bg-color-50 transition-colors">
			Annuler
		</a>
	</div>
{{ form_end(form) }}
